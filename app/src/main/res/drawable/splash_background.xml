<?xml version="1.0" encoding="utf-8"?>
<!-- Splash background — solid black. The Compose UI loads instantly and
     shows the branded home screen, so we don't need a fancy splash.
     (The previous version used <bitmap android:src="@drawable/ic_splash_icon"/>
     which can crash on some OEM ROMs when ic_splash_icon is a vector drawable.) -->
<color xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@android:color/black" />
